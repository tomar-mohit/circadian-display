<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Window theme for the frame drawn before the first Compose frame. The Compose UI owns the real
      colour scheme (see ui/theme/Theme.kt), so this only has to agree with the *system* setting:
      DayNight gives a dark launch frame on a dark device and a light one on a light device. A user
      who overrides the theme against the system may see one frame in the system's colours before
      Compose takes over - accepted in DECISIONS.md #010.
    -->
    <style name="Theme.CircadianDisplay" parent="Theme.Material3.DayNight.NoActionBar" />
</resources>

